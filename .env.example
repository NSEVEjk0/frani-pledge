# Frani Pledge — configuration
# Copy to .env and adjust. All values default to testnet2.

# Network. Must be testnet2. Do not point this at mainnet.
PLEDGE_NETWORK=testnet2

# Where the wallet keys and state live on disk.
PLEDGE_DATA_DIR=./wallet-data

# testnet2 wallet-api base URL.
PLEDGE_WALLET_API=https://wallet-api.unicity.network

# Public testnet2 oracle key (not a secret).
PLEDGE_ORACLE_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# Stable per-machine device id for the wallet-api session.
PLEDGE_DEVICE_ID=frani-pledge-1

# Optional @nametag to register on first run (leave blank to skip).
PLEDGE_NAMETAG=

# Where campaigns are stored.
PLEDGE_DIR=./campaigns

# How often to check for met conditions / expiries, in seconds.
PLEDGE_SWEEP_SECONDS=30
